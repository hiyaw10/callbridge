# Local dev default: SQLite. In Railway/prod, set to the Postgres connection string.
DATABASE_URL=sqlite:///./callbridge.db

# Random long string in prod. Sessions are invalidated if this changes.
SECRET_KEY=dev-secret-change-in-production

# "development" shows local-only hints (like the reset-code fallback) and enables /docs.
# Set to "production" on Railway, including the staging environment, so it behaves like prod.
ENVIRONMENT=development

# Shared secret for /admin (analytics, leads, businesses). Set a long random value in prod.
ADMIN_TOKEN=dev-admin-token

# Leave blank for local dev: SMS sends are simulated (logged, not actually sent)
# and webhook signature validation is skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The deployment's public URL, no trailing slash (e.g. https://www.callbridgeapp.com).
# Needed in prod so cron-sent texts get delivery-status tracking. Blank locally.
PUBLIC_BASE_URL=

# Where /book-a-call sends prospects after they submit. Defaults to the 30 minute event.
# CALENDLY_URL=https://calendly.com/your-account/your-event

# Google Analytics 4 ID (G-XXXXXXXXXX). Leave blank locally and on staging so test
# traffic never reaches the real property. The tag only renders when this is set.
GA_MEASUREMENT_ID=

# Optional. If set, unhandled errors are also reported to Sentry (sentry.io free tier).
# Leave blank to just rely on Railway's logs.
SENTRY_DSN=

# Legal entity named on /legal/privacy and /legal/terms. Set to the exact registered
# name (for example "CallBridge LLC") once the company exists.
# LEGAL_ENTITY_NAME=CallBridge LLC
