# Local dev default: SQLite. In Railway/prod, set to the Postgres connection string.
DATABASE_URL=sqlite:///./callbridge.db

# Random long string in prod. Sessions are invalidated if this changes.
SECRET_KEY=dev-secret-change-in-production

# "development" shows the demo-login hint on the login page. Set to "production" on Railway.
ENVIRONMENT=development

# Shared secret for /admin (add-business form). Set a long random value in prod.
ADMIN_TOKEN=dev-admin-token

# Leave blank for local dev — SMS sends will be simulated (logged, not actually sent)
# and webhook signature validation will be skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
